{
  "name": "payload-seo-autopilot",
  "version": "0.1.0",
  "description": "Automatic SEO for Payload CMS sites: meta fallbacks, sitemap, robots, canonical URLs, redirects and optional AI suggestions, so clients don't need to know SEO.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./next": {
      "import": "./dist/exports/next.js",
      "types": "./dist/exports/next.d.ts",
      "default": "./dist/exports/next.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm clean && pnpm build:types && pnpm build:swc",
    "build:swc": "swc ./src -d ./dist --config-file .swcrc --strip-leading-paths --ignore '**/*.spec.ts'",
    "build:types": "tsc -p tsconfig.build.json",
    "clean": "rimraf {dist,*.tsbuildinfo}",
    "prepare": "pnpm build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=1.7.0",
    "@payloadcms/plugin-redirects": "^3.93.0",
    "@payloadcms/plugin-seo": "^3.93.0",
    "next": ">=15",
    "payload": "^3.93.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "@anthropic-ai/sdk": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.23.4 || >=24.22.1",
    "pnpm": "^9 || ^10 || ^11"
  },
  "packageManager": "pnpm@10.28.0",
  "keywords": [
    "payload",
    "payload-plugin",
    "seo",
    "sitemap",
    "redirects",
    "ai"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bramdenelzen/payload-seo-autopilot.git"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.7.0",
    "@payloadcms/db-sqlite": "3.93.0",
    "@payloadcms/plugin-redirects": "3.93.0",
    "@payloadcms/plugin-seo": "3.93.0",
    "@payloadcms/richtext-lexical": "3.93.0",
    "@payloadcms/ui": "3.93.0",
    "@swc/cli": "0.6.0",
    "@swc/core": "^1.16.22",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "graphql": "^16.15.0",
    "next": "16.3.3",
    "payload": "3.93.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "rimraf": "3.0.2",
    "typescript": "5.7.3",
    "vitest": "4.0.18"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
